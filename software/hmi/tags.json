    {
      "name": "Memory_tags",
      "tagType": "Folder",
      "tags": [
        {
          "name": "DrawingId",
          "tagType": "AtomicTag",
          "value": 6,
          "valueSource": "memory"
        },
        {
          "dataType": "String",
          "executionMode": "FixedRate",
          "executionRate": 1000,
          "expression": "if(timeBetween({[~]FB100_Logic_Call/PlcHeartbeat.Timestamp}, addSeconds(now(), -2), now()), \"RUN\", \"STOPPED\")",
          "formatString": "#,##0.##",
          "name": "PlcStatus",
          "tagType": "AtomicTag",
          "valueSource": "expr"
        },
        {
          "dataType": "String",
          "executionMode": "FixedRate",
          "expression": "if(!{[~]FB100_Logic_Call/EspCommLost}, \"ONLINE\", \"OFFLINE\")",
          "name": "EspOnline",
          "tagType": "AtomicTag",
          "valueSource": "expr"
        },
        {
          "dataType": "String",
          "name": "DrawingExecutionName",
          "tagType": "AtomicTag",
          "value": "Lancia Delta 1980",
          "valueSource": "memory"
        },
        {
          "name": "DrawingExecutionId",
          "tagType": "AtomicTag",
          "value": 41,
          "valueSource": "memory"
        },
        {
          "dataType": "String",
          "expression": "if(isGood({[~]ESP32_Response/ResponseZswByte2}), if({[~]DB/AutoCmd}, \"AUTO\", \"MANUAL\"), \"N/A\")",
          "name": "Mode",
          "tagType": "AtomicTag",
          "valueSource": "expr"
        },
        {
          "dataType": "String",
          "executionMode": "FixedRate",
          "expression": "if({[~]FB100_Logic_Call/PlcHeartbeat.Quality} \u003d \"Good\", \"ONLINE\", \"OFFLINE\")",
          "name": "PlcOnline",
          "tagType": "AtomicTag",
          "valueSource": "expr"
        },
        {
          "name": "PlcToEspCycle",
          "tagType": "AtomicTag",
          "value": 100,
          "valueSource": "memory"
        },
        {
          "dataType": "String",
          "executionMode": "FixedRate",
          "expression": "if({[.]PlcStatus} !\u003d \"RUN\", \"PLC STOP\", if({[.]ErrorCode} \u003e 0, \"FAULT\", if({[~]DB/EstopCmd}, \"ESTOP\", if({[~]DB/StopCmd}, \"STOPPED\", if({[~]DB/AutoCmd}, \"RUNNING\", \"IDLE\")))))",
          "name": "PlotterState",
          "tagType": "AtomicTag",
          "valueSource": "expr"
        },
        {
          "expression": "if({[~]FB100_Logic_Call/EspCommLost}, \"3500\", {[~]ESP32_Response/ResponseErrorCode})",
          "name": "ErrorCode",
          "tagType": "AtomicTag",
          "valueSource": "expr"
        },
        {
          "name": "EspToPlcCycle",
          "tagType": "AtomicTag",
          "value": 101,
          "valueSource": "memory"
        },
        {
          "dataType": "String",
          "expression": "if(isGood({[~]ESP32_Response/ResponseZswByte2}), if(getBit({[~]ESP32_Response/ResponseZswByte2}, 1) \u0026\u0026 getBit({[~]ESP32_Response/ResponseZswByte2}, 2), \"REACHED\", \"NOT REACHED\"), \"N/A\")",
          "name": "Homed",
          "tagType": "AtomicTag",
          "valueSource": "expr"
        }
      ]
    },
