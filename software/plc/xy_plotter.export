        <Single Name="ParentGuid" Type="System.Guid">6e46135e-d842-46ca-ac72-50df977c8780</Single>
        <Single Name="Name" Type="string">FB100_Logic_Call</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties" />
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639262936799026744</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">
// pc: 192.168.0.100
// plc: 192.168.0.254
// esp: 192.168.0.154

// Plc Heartbit for Ignition
PlcHeartbeat := PlcHeartbeat + 2;

// Reset the homing command when automatic mode is active or both axes have reached their home positions
IF DB.AutoCmd OR (xEspHomeX AND xEspHomeY) THEN
	DB.HomeCmd := FALSE;
END_IF;

IF RCV_ESP_Buffer.TCP_ESP_RCV.ResponseLastContDone &gt;= Drawing.TotalNumbContours THEN
	DB.AutoCmd := FALSE;
END_IF

// Reset the target moving command when both axes have reached their positions
TargetReached := ABS(UINT_TO_INT(RCV_ESP_Buffer.TCP_ESP_RCV.ResponseCoord_X) - DB.TargetX * 100) &lt;= 1 AND ABS(UINT_TO_INT(RCV_ESP_Buffer.TCP_ESP_RCV.ResponseCoord_Y) - DB.TargetY * 100) &lt;= 1;

IF DB.MoveToTargetCmd AND TargetReached THEN
    DB.MoveToTargetCmd := FALSE;
END_IF;

// Cancel automatic movement and homing when a stop command is active
IF DB.StopCmd THEN
	DB.AutoCmd := FALSE;
	DB.HomeCmd := FALSE;
	DB.MoveToTargetCmd := FALSE;
END_IF;

// Prepare commands and exchange drawing data with the ESP
FB300_ESP_Cmd(Enable := NOT DB.RcvDataFromPC,
              ContourTotalNum := Drawing.TotalNumbContours,
              PointsTotalNum := Drawing.TotalNumbPoints,
              TCP_Conn_Estab := xEspConnected,
              TCP_Snd_Done := xEspSendDone,
              TCP_Rcv_Ndr := xEspReceiveNdr,
			  ConnLost := EspCommLost,
              TCP_Snd_Req =&gt; xEspSendReq,
              TCP_Rcv_Req =&gt; xEspReceiveReq,
			  SnsrHomeX =&gt; xEspHomeX,
              SnsrHomeY =&gt; xEspHomeY);
			  
// Manage the TCP connection and data exchange between the PLC and ESP
FB200_TCP_ESP(Enable := NOT DB.RcvDataFromPC,
			  SndRequest  := xEspSendReq,
    		  RcvRequest  := xEspReceiveReq,
    		  Connected   =&gt; xEspConnected,
     		  SndDone     =&gt; xEspSendDone,
    		  RcvNdr      =&gt; xEspReceiveNdr);	

EspCommLostTimer(IN := NOT xEspReceiveNdr, PT := T#3S);
EspCommLost := EspCommLostTimer.Q;
 </Single>
            <Single Name="LineInfoPersistence" Type="string">567c3133-880f-4e44-ae54-9c07177afa2e_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">PROGRAM FB100_Logic_Call

VAR
	TcpPcDone      : BOOL := FALSE;
    TcpPcDataSaved : BOOL := FALSE;	

    xDeleteDrwReq  : BOOL := FALSE;
    xDeleteDrwDone : BOOL := FALSE;
    xAckReq        : BOOL := FALSE;
    xAckReset      : BOOL := FALSE;

    xEspConnected  : BOOL := FALSE;
    xEspSendDone   : BOOL := FALSE;
    xEspReceiveNdr : BOOL := FALSE;
    xEspSendReq    : BOOL := FALSE;
    xEspReceiveReq : BOOL := FALSE;

    xEspHomeX      : BOOL := FALSE;
    xEspHomeY      : BOOL := FALSE;
	
	PlcHeartbeat   : UDINT := 0;
	
	TargetReached  : BOOL := FALSE;
	
	EspCommLostTimer 	: TON;
	EspCommLost 		: BOOL := FALSE;
	
	FB300_ESP_Cmd : FB300_ESP_Cmd;
	FB200_TCP_ESP : FB200_TCP_ESP;
END_VAR

VAR CONSTANT
    RcvPcBufferSize : INT := 500;
    DrwContourSize  : INT := 500;
    DrwPointSize    : INT := 7000;
END_VAR</Single>
            <Single Name="LineInfoPersistence" Type="string">567c3133-880f-4e44-ae54-9c07177afa2e_Decl_LineIds</Single>
          </Single>
