            <Single Name="TextBlobForSerialisation" Type="string">TYPE TCP_ESP_RCV :
	
STRUCT
	ResponseZswByte1       : BYTE;         		// ESP32 status word
	ResponseZswByte2       : BYTE;         		// ESP32 status word
    ResponseNumExpected    : UINT := 0;    		// Next expected point number
    ResponseLastContRcv    : UINT := 0;    		// Last contour received
    ResponseLastContDone   : UINT := 0;    		// Last contour completed
    ResponseCurrPoint      : UINT := 0;    		// Current point number
    ResponseCoord_X        : UINT := 0;   		// Current X coordinate
    ResponseCoord_Y        : UINT := 0;    		// Current Y coordinate
    ResponsePointsInBuffer : UINT := 0;    		// Number of points currently stored in buffer
    ResponseErrorCode      : UINT := 0;    		// ESP32 error code
	ResponseDrawingState   : USINT := 0;	    // Running - 1, aborted - 2, finished - 3
END_STRUCT

END_TYPE
</Single>
