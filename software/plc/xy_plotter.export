        <Single Name="Name" Type="string">FB200_TCP_ESP</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties" />
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639261465940979877</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">
// State timers
STEP_TIME(IN := SSW = 3, PT := T#5000MS, Q  =&gt; TonStepQ);
RETRY_TIME(IN := NOT TCP_Rcv.Ndr AND SSW &gt; 0 AND SSW &lt; 3, PT := T#5100MS, Q  =&gt; TonRetryQ);

// Detect communication enable and disable edges //
RtrigEnable(CLK := Enable);
FtrigEnable(CLK := Enable);

// Disconnect on communication enable/disable event or retry timeout
IF RtrigEnable.Q OR FtrigEnable.Q OR TonRetryQ THEN
    SSW := 3;
END_IF;

// Default commands
TCP_Con.Req := FALSE;
TCP_Snd.Req := FALSE;
TCP_Rcv.Req := FALSE;

// State machine
CASE SSW OF

    0:  // Initial step
        IF Enable THEN
            SSW := 1;
        END_IF;

    1:  // Establish connection
        TCP_Con.Req := TRUE;

        IF TCP_Con.Active THEN
            SSW := 2;

        ELSIF TCP_Con.Error THEN
            Err := Err + 1;
			SSW := 3;
            // SSW := 4;
        END_IF;

	2:  // Connected

		TCP_Con.Req := TRUE;
		TCP_Snd.Req := SndRequest;
		TCP_Rcv.Req := RcvRequest;
	
		IF TCP_Con.Error OR TCP_Snd.Error OR TCP_Rcv.Error THEN
			Err := Err + 1;
			SSW := 3;
		END_IF;
		
    3:  // Close connection
        TCP_Con.Req := FALSE;
        TCP_Snd.Req := FALSE;
        TCP_Rcv.Req := FALSE;
		
		IF TonStepQ THEN
            SSW := 0;
        END_IF;

ELSE

	SSW := 3;

END_CASE;

// TCP client
fbClient(
    xEnable       := TCP_Con.Req,
    xDone         =&gt; TCP_Con.Done,
    xBusy         =&gt; TCP_Con.Busy,
    xError        =&gt; TCP_Con.Error,
    eErrorID      =&gt; TCP_Con.ErrorID,
    itfIPAddress  := ipESP,
    uiPort        := 2001,
    xActive       =&gt; TCP_Con.Active,
    itfConnection =&gt; Connection
);

// Receive data from ESP
fbRead(
    xEnable       := TCP_Rcv.Req,
    xBusy         =&gt; TCP_Rcv.Busy,
    xError        =&gt; TCP_Rcv.Error,
    eErrorID      =&gt; TCP_Rcv.ErrorID,
    itfConnection := Connection,
    pData         := ADR(RCV_ESP_Buffer.TCP_ESP_RCV),
    udiSize       := SIZEOF(RCV_ESP_Buffer.TCP_ESP_RCV),
    xReady        =&gt; TCP_Rcv.Ndr,
    udiCount      =&gt; TCP_Rcv.Len
);

// Send data to ESP
fbWrite(
    xExecute      := TCP_Snd.Req,
    xDone         =&gt; TCP_Snd.Done,
    xBusy         =&gt; TCP_Snd.Busy,
    xError        =&gt; TCP_Snd.Error,
    eErrorID      =&gt; TCP_Snd.ErrorID,
    itfConnection := Connection,
    pData         := ADR(SND_ESP_Buffer.TCP_ESP_SND),
    udiSize       := SIZEOF(SND_ESP_Buffer.TCP_ESP_SND),
    udiCount      =&gt; TCP_Snd.Len
);

// Outputs for FB302_ESP_Cmd
Connected := TCP_Con.Active;
SndDone   := TCP_Snd.Done;
RcvNdr    := TCP_Rcv.Ndr;</Single>
            <Single Name="LineInfoPersistence" Type="string">028f74d1-dfac-40ba-9faa-578913e4d485_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">{attribute 'no_assign'}
FUNCTION_BLOCK FB200_TCP_ESP

VAR_INPUT
	Enable 				: BOOL;
	SndRequest  		: BOOL;
    RcvRequest  		: BOOL;
END_VAR

VAR_IN_OUT
END_VAR

VAR_OUTPUT
	Connected 			: BOOL;
    SndDone   			: BOOL;
    RcvNdr    			: BOOL;
END_VAR

VAR
	SSW       			: INT := 0;
    OLD_SSW   			: INT := 0;
    TCP_Con   			: TCP_Con;
    Err       			: INT := 0;
    STEP_TIME 			: TON;
    RETRY_TIME			: TON;
    TonStepQ  			: BOOL;
    TonRetryQ 			: BOOL;
	
    RtrigEnable     	: R_TRIG;
    FtrigEnable     	: F_TRIG;
    ComOk     			: BOOL := FALSE;
    SendCntr  			: UINT := 0;
	
	TCP_Rcv   			: TCP_Rcv;
    TCP_Snd   			: TCP_Snd;
	
	fbClient 			: NBS.TCP_Client;
    fbRead   			: NBS.TCP_Read;
    fbWrite  			: NBS.TCP_Write;
	Connection			: NBS.IConnection;
	ipESP				: NBS.IPv4Address := (ipAddress := '192.168.0.154');
	
	TEST : BOOL;
END_VAR
</Single>
            <Single Name="LineInfoPersistence" Type="string">028f74d1-dfac-40ba-9faa-578913e4d485_Decl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="UniqueIdGenerator" Type="string">466</Single>
        <Single Name="POULevel" Type="{8e575c5b-1d37-49c6-941b-5c0ec7874787}">Standard</Single>
        <List Name="ChildObjectGuids" Type="System.Collections.ArrayList" />
        <Single Name="AddAttributeSubsequent" Type="bool">False</Single>
      </Single>
      <Single Name="ParentSVNodeGuid" Type="System.Guid">6e46135e-d842-46ca-ac72-50df977c8780</Single>
      <Array Name="Path" Type="string">
        <Single Type="string">Device</Single>
        <Single Type="string">Plc Logic</Single>
        <Single Type="string">Application</Single>
      </Array>
      <Single Name="Index" Type="int">-1</Single>
    </Single>
    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">False</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">94eba61b-e3cf-4166-8f4c-bd93b8327d97</Single>
        <Single Name="ParentGuid" Type="System.Guid">6e46135e-d842-46ca-ac72-50df977c8780</Single>
        <Single Name="Name" Type="string">FB300_ESP_Cmd</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties" />
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639262353688885318</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">
SAVE_TIMER(IN := SSW &gt; 1, PT := T#5S, Q =&gt; SAVE_T.Q);
RETRY_TIME(IN := Enable AND SSW = 5, PT := T#200MS, Q  =&gt; TonRetryQ);

// Reset state machine when disabled
IF NOT Enable THEN
	SSW := 0;
	PrevNumExpected := 0;
END_IF;

RtrigConnLost(CLK := ConnLost);

IF RtrigConnLost.Q THEN
	SSW := 0;
END_IF;

CASE SSW OF
		
	0:  // Initial state
		RCV_ESP_Buffer.TCP_ESP_RCV.ResponseZswByte1 := 0;
		RCV_ESP_Buffer.TCP_ESP_RCV.ResponseZswByte2 := 0;
		EspZsw.RdyForRcvNewPnt := FALSE;
		SND_ESP_Buffer.TCP_ESP_SND := SND_ESP_Buffer.Default;
		
		IF Enable THEN
			CurrContForSend := 1;
			PrevNumExpected := 0;
			SSW := 3;
		END_IF;
		
	1:  // Check whether the ESP is ready to receive a new point
		IF EspZsw.RdyForRcvNewPnt THEN
			CurrNumExpected := RCV_ESP_Buffer.TCP_ESP_RCV.ResponseNumExpected;
			
			// Reset contour number when ESP requests the first point of a new drawing
			IF CurrNumExpected = 1 THEN
				CurrContForSend := 1;
			END_IF;
			
			// ESP requests the first point or the next sequential point
			IF (CurrNumExpected = 1 OR CurrNumExpected = PrevNumExpected + 1) AND CurrNumExpected &lt;= PointsTotalNum THEN
				SSW := 2;
			
				// Switch to the next contour when the requested point is outside the current contour range
				WHILE CurrNumExpected &gt; Drawing.Contour[CurrContForSend].StartIndex + Drawing.Contour[CurrContForSend].PointCount - 1 AND CurrContForSend &lt; Drawing.TotalNumbContours DO
					CurrContForSend := CurrContForSend + 1; 
				END_WHILE;
				
			// ESP received the last point
			ELSIF CurrNumExpected - 1 = PointsTotalNum THEN
				SSW := 3;
			
			// ESP is still requesting the previously sent point
			ELSIF CurrNumExpected = PrevNumExpected THEN
				SSW := 3;
			END_IF;
		ELSE
			// Send dummy values while still updating the control word.
			SND_ESP_Buffer.TCP_ESP_SND.CommandPointNum := 9999;
			SND_ESP_Buffer.TCP_ESP_SND.CommandSpeed := 9999;
			SND_ESP_Buffer.TCP_ESP_SND.CommandCoord_X := 9999;
			SND_ESP_Buffer.TCP_ESP_SND.CommandCoord_Y := 9999;
			AssignBit(Value := SND_ESP_Buffer.TCP_ESP_SND.CommandPointFlags, BitNumber := 0, State := FALSE);    // Clear bit 0
			AssignBit(Value := SND_ESP_Buffer.TCP_ESP_SND.CommandPointFlags, BitNumber := 1, State := FALSE);    // Clear bit 1
			AssignBit(Value := SND_ESP_Buffer.TCP_ESP_SND.CommandPointFlags, BitNumber := 2, State := FALSE);    // Clear bit 2
			SSW := 3;
		END_IF;
		
	2:  // Prepare point data in the send buffer
		
		// Point data
		SND_ESP_Buffer.TCP_ESP_SND.CommandPointNum := CurrNumExpected;                                  
		SND_ESP_Buffer.TCP_ESP_SND.CommandSpeed := Drawing.Points[CurrNumExpected].Speed;           
		SND_ESP_Buffer.TCP_ESP_SND.CommandCoord_X := Drawing.Points[CurrNumExpected].Coord_X;        
		SND_ESP_Buffer.TCP_ESP_SND.CommandCoord_Y := Drawing.Points[CurrNumExpected].Coord_Y;         
		
		// Detect the first and last point of the current contour
		IsFirstPointOfContour :=
			CurrNumExpected = Drawing.Contour[CurrContForSend].StartIndex;
		
		IsLastPointOfContour :=
			CurrNumExpected =
			Drawing.Contour[CurrContForSend].StartIndex
			+ Drawing.Contour[CurrContForSend].PointCount - 1;
		
		SND_ESP_Buffer.TCP_ESP_SND.CommandContourNum := CurrContForSend;
		
		AssignBit(Value := SND_ESP_Buffer.TCP_ESP_SND.CommandPointFlags, BitNumber := 0, State := IsLastPointOfContour);
		AssignBit(Value := SND_ESP_Buffer.TCP_ESP_SND.CommandPointFlags, BitNumber := 1, State := Drawing.Points[CurrNumExpected].CmdType &lt;&gt; 2);
		
		// Check whether this is the final point of the entire drawing
		AssignBit(Value := SND_ESP_Buffer.TCP_ESP_SND.CommandPointFlags, BitNumber := 2, State := CurrNumExpected = PointsTotalNum);
		
		IF Drawing.Points[CurrNumExpected].CmdType = 2 THEN
			DebugPointNum := CurrNumExpected;
			DebugFirstPoint := IsFirstPointOfContour;
			DebugPointFlags := SND_ESP_Buffer.TCP_ESP_SND.CommandPointFlags;
		END_IF;
		
		IF DB.CleanCmd THEN
			SND_ESP_Buffer.TCP_ESP_SND := SND_ESP_Buffer.Default;
		END_IF;
		
		SSW := 3;
		
	3:  // Prepare the control word
		
		SND_ESP_Buffer.TCP_ESP_SND.CommandManMoveSpeed := INT_TO_UINT(DB.ManMoveSpeed);
		SND_ESP_Buffer.TCP_ESP_SND.CommandTargetMoveSpeed := INT_TO_UINT(DB.TargetMoveSpeed);
		SND_ESP_Buffer.TCP_ESP_SND.CommandTargetX := INT_TO_UINT(DB.TargetX * 100);
		SND_ESP_Buffer.TCP_ESP_SND.CommandTargetY := INT_TO_UINT(DB.TargetY * 100);
		
		AssignBit(Value := SND_ESP_Buffer.TCP_ESP_SND.CommandStw, BitNumber := 0,  State := NOT DB.StopCmd);                                              // stop off1
		AssignBit(Value := SND_ESP_Buffer.TCP_ESP_SND.CommandStw, BitNumber := 1,  State := NOT DB.EstopCmd);                                             // estop off2
		AssignBit(Value := SND_ESP_Buffer.TCP_ESP_SND.CommandStw, BitNumber := 2,  State := DB.AutoCmd);                                                  // auto or manual move by hmi
		AssignBit(Value := SND_ESP_Buffer.TCP_ESP_SND.CommandStw, BitNumber := 3,  State := DB.MoveCmd);                                                  // move enable
		AssignBit(Value := SND_ESP_Buffer.TCP_ESP_SND.CommandStw, BitNumber := 4,  State := DB.HomeCmd);                                                  // home
		AssignBit(Value := SND_ESP_Buffer.TCP_ESP_SND.CommandStw, BitNumber := 5,  State := DB.CleanCmd);                                                 // clean buffer
		AssignBit(Value := SND_ESP_Buffer.TCP_ESP_SND.CommandStw, BitNumber := 6,  State := DB.ManualPenDn);                                              // manual mode: pen down
		AssignBit(Value := SND_ESP_Buffer.TCP_ESP_SND.CommandStw, BitNumber := 7,  State := DB.ManMoveEast OR DB.ManMoveNEast OR DB.ManMoveSEast);       // manual mode: X positive
		AssignBit(Value := SND_ESP_Buffer.TCP_ESP_SND.CommandStw, BitNumber := 8,  State := DB.ManMoveWest OR DB.ManMoveNWest OR DB.ManMoveSWest);       // manual mode: X negative
		AssignBit(Value := SND_ESP_Buffer.TCP_ESP_SND.CommandStw, BitNumber := 9,  State := DB.ManMoveNorth OR DB.ManMoveNEast OR DB.ManMoveNWest);      // manual mode: Y positive
		AssignBit(Value := SND_ESP_Buffer.TCP_ESP_SND.CommandStw, BitNumber := 10, State := DB.ManMoveSouth OR DB.ManMoveSEast OR DB.ManMoveSWest);      // manual mode: Y negative
		AssignBit(Value := SND_ESP_Buffer.TCP_ESP_SND.CommandStw, BitNumber := 11, State := DB.MoveToTargetCmd);      									 // target mode: start
		AssignBit(Value := SND_ESP_Buffer.TCP_ESP_SND.CommandStw, BitNumber := 12, State := DB.TargetPenDn);      										 // target mode: pen down
		
		// Continue with transmission when the TCP connection is established
		IF TCP_Conn_Estab THEN
			SSW := 4;
		ELSE
			SSW := 1;
		END_IF;
		
	4:  // Send point and control data
		IF TCP_Snd_Done THEN
			SSW := 5;
			
			// Store the last successfully sent point number
			IF EspZsw.RdyForRcvNewPnt AND SND_ESP_Buffer.TCP_ESP_SND.CommandPointNum &lt;&gt; 9999 THEN
				PrevNumExpected := SND_ESP_Buffer.TCP_ESP_SND.CommandPointNum;
			END_IF;
		END_IF;
		
	5:  // Wait for ESP response containing the next expected point number
		IF TCP_Rcv_Ndr THEN
			
			// Detect an unexpected jump in the requested point number
			IF RCV_ESP_Buffer.TCP_ESP_RCV.ResponseNumExpected &gt; CurrNumExpected + 1 THEN
				ErrPointNum := ErrPointNum + 1;
			END_IF;
			
			NewContDone := UINT_TO_INT(RCV_ESP_Buffer.TCP_ESP_RCV.ResponseLastContDone);
			NewContRcvd := UINT_TO_INT(RCV_ESP_Buffer.TCP_ESP_RCV.ResponseLastContRcv);
			SSW := 6;
		ELSIF TonRetryQ THEN
			SSW := 4;	
		END_IF;
		
	6:  // Update ESP status word
		EspZsw.RdyForRcvNewPnt := RCV_ESP_Buffer.TCP_ESP_RCV.ResponseZswByte1.%X0;         // ready for rcv new point
		EspZsw.RdyForEn := RCV_ESP_Buffer.TCP_ESP_RCV.ResponseZswByte1.%X1;                // ready for switching on
		EspZsw.Enabled := RCV_ESP_Buffer.TCP_ESP_RCV.ResponseZswByte1.%X2;                 // enabled
		EspZsw.Off1 := RCV_ESP_Buffer.TCP_ESP_RCV.ResponseZswByte1.%X3;                    // off1
		EspZsw.Off2 := RCV_ESP_Buffer.TCP_ESP_RCV.ResponseZswByte1.%X4;                    // off2
		EspZsw.PenDn := RCV_ESP_Buffer.TCP_ESP_RCV.ResponseZswByte1.%X5;                   // pen down
		EspZsw.RdyContPrevDrw := RCV_ESP_Buffer.TCP_ESP_RCV.ResponseZswByte1.%X6;          // ready to continue drw
		EspZsw.RdyStartNewDrw := RCV_ESP_Buffer.TCP_ESP_RCV.ResponseZswByte1.%X7;          // ready to start new drw
		EspZsw.DrwProccAct := RCV_ESP_Buffer.TCP_ESP_RCV.ResponseZswByte2.%X0;             // drw in process
		EspZsw.SnsrHomeX := RCV_ESP_Buffer.TCP_ESP_RCV.ResponseZswByte2.%X1;               // sensor home x
		EspZsw.SnsrHomeY := RCV_ESP_Buffer.TCP_ESP_RCV.ResponseZswByte2.%X2;               // sensor home y
		EspZsw.SnsrLimitX := RCV_ESP_Buffer.TCP_ESP_RCV.ResponseZswByte2.%X3;              // sensor limit x
		EspZsw.SnsrLimitY := RCV_ESP_Buffer.TCP_ESP_RCV.ResponseZswByte2.%X4;              // sensor limit y
		EspZsw.MovingAuto := RCV_ESP_Buffer.TCP_ESP_RCV.ResponseZswByte2.%X5;              // auto move
		EspZsw.MovingHome := RCV_ESP_Buffer.TCP_ESP_RCV.ResponseZswByte2.%X6;              // homing move
		EspZsw.MovingManual := RCV_ESP_Buffer.TCP_ESP_RCV.ResponseZswByte2.%X7;            // manual move
		SSW := 7;
		
	7:  // Update contour status flags
		IF NewContDone &gt; PrevContDone THEN                                        // Mark newly completed contours as done
			FOR i_cntr := PrevContDone + 1 TO NewContDone DO
				Drawing.Contour[i_cntr].Done := TRUE;
				
				// Periodically save the last completed point number
				IF i_cntr = NewContDone AND SAVE_T.Q THEN
					SavedPointNum := Drawing.Contour[i_cntr].StartIndex + Drawing.Contour[i_cntr].PointCount;
				END_IF;
			END_FOR;
		END_IF;
		
		// Mark newly received contours as received by the ESP
		IF NewContRcvd &gt; PrevContRcvd THEN                                
			FOR i_cntr := PrevContRcvd + 1 TO NewContRcvd DO
				Drawing.Contour[i_cntr].RcvdByEsp := TRUE;
			END_FOR;
		END_IF;
		
		// Convert the current ESP coordinates to engineering units
		CurrCoordEsp.X := UINT_TO_REAL(RCV_ESP_Buffer.TCP_ESP_RCV.ResponseCoord_X) / 100;
		CurrCoordEsp.Y := UINT_TO_REAL(RCV_ESP_Buffer.TCP_ESP_RCV.ResponseCoord_Y) / 100;
		
		// Store contour status for comparison during the next cycle
		PrevContDone := NewContDone;
		PrevContRcvd := NewContRcvd;
		
		SSW := 1;
		
END_CASE;

// Generate TCP send and receive requests
TCP_Snd_Req := SSW = 4;
TCP_Rcv_Req := SSW = 5;
SnsrHomeX := EspZsw.SnsrHomeX;
SnsrHomeY := EspZsw.SnsrHomeY;


	</Single>
            <Single Name="LineInfoPersistence" Type="string">94eba61b-e3cf-4166-8f4c-bd93b8327d97_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">FUNCTION_BLOCK FB300_ESP_Cmd

VAR_INPUT
    Enable           		: BOOL;
    ContourTotalNum  		: UINT;
    PointsTotalNum   		: UINT;
    TCP_Conn_Estab   		: BOOL;
    TCP_Snd_Done     		: BOOL;
    TCP_Rcv_Ndr      		: BOOL;
	ConnLost				: BOOL;
END_VAR

VAR_OUTPUT
    TCP_Snd_Req     		: BOOL;
    TCP_Rcv_Req      		: BOOL;
    SavedPointNum    		: UINT;
    SnsrHomeX   : BOOL;
    SnsrHomeY   : BOOL;
END_VAR

VAR_IN_OUT
END_VAR

VAR
    SSW                 	: INT := 0;
    ErrPointNum         	: INT := 0;
    NewContDone         	: INT := 0;
    NewContRcvd         	: INT := 0;
    PrevContDone        	: INT := 0;
    PrevContRcvd        	: INT := 0;
    CurrNumExpected     	: UINT := 0;
    PrevNumExpected     	: UINT := 0;
    CurrContForSend     	: UINT := 0;
    PrevContForSend     	: UINT := 0;
    IsFirstPointOfContour 	: BOOL := FALSE;
    IsLastPointOfContour  	: BOOL := FALSE;
    CurrCoordEsp        	: ESP_Coord;
    EspZsw             		: ESP_Zsw;
    SAVE_TIMER         		: TON;
	RETRY_TIME				: TON;
	TonRetryQ 				: BOOL;
    SAVE_T             		: TMR;
	RtrigConnLost			: R_TRIG;
	
	DebugPointNum : UINT;
	DebugFirstPoint : BOOL;
	DebugPointFlags : UINT;
END_VAR

VAR_TEMP
    i_cntr 					: INT;
    j_cntr 					: INT;
END_VAR

VAR CONSTANT
END_VAR
</Single>
            <Single Name="LineInfoPersistence" Type="string">94eba61b-e3cf-4166-8f4c-bd93b8327d97_Decl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="UniqueIdGenerator" Type="string">786</Single>
        <Single Name="POULevel" Type="{8e575c5b-1d37-49c6-941b-5c0ec7874787}">Standard</Single>
        <List Name="ChildObjectGuids" Type="System.Collections.ArrayList" />
        <Single Name="AddAttributeSubsequent" Type="bool">False</Single>
      </Single>
      <Single Name="ParentSVNodeGuid" Type="System.Guid">6e46135e-d842-46ca-ac72-50df977c8780</Single>
      <Array Name="Path" Type="string">
        <Single Type="string">Device</Single>
        <Single Type="string">Plc Logic</Single>
        <Single Type="string">Application</Single>
      </Array>
      <Single Name="Index" Type="int">-1</Single>
    </Single>
    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">False</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">d6deaef0-38ac-4298-93a1-2804a38b6728</Single>
