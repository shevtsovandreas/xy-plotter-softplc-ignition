            <Single Name="TextBlobForSerialisation" Type="string">TYPE ESP_Resp :

STRUCT
    ZSW_Byte1     : BYTE := 16#00;      // Status byte 1
    ZSW_Byte2     : BYTE := 16#00;      // Status byte 2
    NumExpected   : UINT := 0;          // Next expected point number
    LastContRcv   : UINT := 0;          // Last contour received
    LastContDone  : UINT := 0;          // Last contour completed
    CurrPoint     : UINT := 0;          // Current point number
    Coord_X       : UINT := 0;          // Current X coordinate
    Coord_Y       : UINT := 0;          // Current Y coordinate
    PointsInBuffer: UINT := 0;          // Number of points currently stored
    ErrorCode     : UINT := 0;          // ESP32 error code
	DrawingState  : USINT := 0;	    	// Running - 1, aborted - 2, finished - 3
END_STRUCT

